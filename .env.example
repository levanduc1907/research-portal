# ==========================================
# UIUC Research Portal & AI Assistant - Central Environment Config
# ==========================================

# 1. Environment & Ports
NODE_ENV=development
WEB_PORT=3000
API_PORT=4000
WORKER_PORT=4001
NEXT_PUBLIC_API_URL=http://localhost:4000

# 2. MySQL Database
DATABASE_URL="mysql://uiuc_user:uiuc_password@localhost:3306/uiuc_research"
MYSQL_ROOT_PASSWORD=root_password
MYSQL_DATABASE=uiuc_research
MYSQL_USER=uiuc_user
MYSQL_PASSWORD=uiuc_password

# 3. Redis & BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379"

# 4. Qdrant Vector Database
QDRANT_URL="http://localhost:6333"
QDRANT_COLLECTION="uiuc_papers_v1"

# 5. OpenAlex Ingestion Settings
OPENALEX_BASE_URL="https://api.openalex.org"
OPENALEX_CONTACT_EMAIL="research-portal@illinois.edu"
UIUC_OPENALEX_INSTITUTION_ID="I157725225"
IMPORT_FROM_DATE="2024-01-01"
IMPORT_TO_DATE="2026-12-31"
IMPORT_BATCH_SIZE=100

# 6. LLM & Embeddings (OpenAI or Compatible)
OPENAI_API_KEY="your-secret-key-here"
LLM_MODEL="gpt-4o-mini"
EMBEDDING_MODEL="text-embedding-3-small"
