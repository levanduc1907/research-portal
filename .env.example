# ==========================================
# UIUC Research Portal & AI Assistant - Central Environment Config
# ==========================================

# 1. Environment & Ports
NODE_ENV=development
WEB_PORT=3000
API_PORT=4000
WORKER_PORT=4001
NEXT_PUBLIC_API_URL=http://localhost:4000

# 2. MySQL Database
DATABASE_URL="mysql://uiuc_user:uiuc_password@localhost:3306/uiuc_research"
MYSQL_ROOT_PASSWORD=root_password
MYSQL_DATABASE=uiuc_research
MYSQL_USER=uiuc_user
MYSQL_PASSWORD=uiuc_password

# 3. Redis & BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379"

# 4. Qdrant Vector Database
QDRANT_URL="http://localhost:6333"
QDRANT_COLLECTION="uiuc_papers_v1"

# 5. OpenAlex Ingestion Settings
OPENALEX_BASE_URL="https://api.openalex.org"
OPENALEX_CONTACT_EMAIL="ichikunana197@gmail.com"
UIUC_OPENALEX_INSTITUTION_ID="I157725225"
# Publication date filters: either exact dates (YYYY-MM-DD) or year range
# IMPORT_FROM_DATE="2024-01-15"
# IMPORT_TO_DATE="2026-03-20"
IMPORT_FROM_YEAR=2024
IMPORT_TO_YEAR=2026
IMPORT_BATCH_SIZE=200
IMPORT_PAPER_TARGET=20000
IMPORT_FACULTY_TARGET=1000
IMPORT_KEYWORDS_LIMIT=40

# 6. AI provider credential vault infrastructure
# Provider API keys, models, and base URLs are stored in the ai_credentials table.
# This master key encrypts those database values and must remain outside the database.
AI_CREDENTIAL_ENCRYPTION_KEY="replace-with-at-least-32-random-characters"
AI_CREDENTIALS_ADMIN_TOKEN="replace-with-a-separate-admin-token"
