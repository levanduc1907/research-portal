# ==========================================
# UIUC Research Portal & AI Assistant - Central Environment Config
# ==========================================

# 1. Environment & Ports
NODE_ENV=development
WEB_PORT=3000
API_PORT=4000
WORKER_PORT=4001
NEXT_PUBLIC_API_URL=http://localhost:4000
CORS_ORIGINS="http://localhost:3000"
# Set an exact hop count such as 1 when deployed behind one trusted proxy.
TRUST_PROXY=""
REQUEST_BODY_LIMIT="16kb"
ENABLE_SWAGGER="true"

# 2. MySQL Database
DATABASE_URL="mysql://uiuc_user:uiuc_password@localhost:3306/uiuc_research"
MYSQL_ROOT_PASSWORD=root_password
MYSQL_DATABASE=uiuc_research
MYSQL_USER=uiuc_user
MYSQL_PASSWORD=uiuc_password

# 3. Redis & BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379"

# Distributed traffic protection. Production refuses to serve when Redis is unavailable.
SECURITY_REQUIRE_REDIS="false"
SECURITY_RATE_LIMIT_ENABLED="true"
ANONYMOUS_SESSION_SECRET="replace-with-at-least-32-random-characters"
SESSION_COOKIE_SAME_SITE="lax"
RATE_LIMIT_PUBLIC_PER_MINUTE=120
RATE_LIMIT_DEPARTMENT_PER_MINUTE=30
RATE_LIMIT_CHAT_ANON_PER_MINUTE=5
RATE_LIMIT_CHAT_ANON_PER_DAY=30
RATE_LIMIT_CHAT_AUTH_PER_MINUTE=10
RATE_LIMIT_CHAT_AUTH_PER_DAY=200
RATE_LIMIT_ADMIN_PER_MINUTE=10
CHAT_MAX_CONCURRENT_GLOBAL=20
CHAT_MAX_CONCURRENT_ANON=1
CHAT_MAX_CONCURRENT_AUTH=2
CHAT_REQUEST_TIMEOUT_MS=60000

# 4. Qdrant Vector Database
QDRANT_URL="http://localhost:6333"
QDRANT_COLLECTION="uiuc_papers_e5_v1"

# 5. OpenAlex Ingestion Settings
OPENALEX_BASE_URL="https://api.openalex.org"
OPENALEX_CONTACT_EMAIL="ichikunana197@gmail.com"
UIUC_OPENALEX_INSTITUTION_ID="I157725225"
# Publication date filters: either exact dates (YYYY-MM-DD) or year range
# IMPORT_FROM_DATE="2024-01-15"
# IMPORT_TO_DATE="2026-03-20"
IMPORT_FROM_YEAR=2024
IMPORT_TO_YEAR=2026
IMPORT_BATCH_SIZE=100
IMPORT_PAPER_TARGET=20000
RESEARCHER_PAPER_IMPORT_BATCH_SIZE=100
RESEARCHER_PAPER_PERSIST_CONCURRENCY=8
IMPORT_FACULTY_TARGET=1000
IMPORT_KEYWORDS_LIMIT=40

# 6. AI provider credential vault infrastructure
# Provider API keys, models, and base URLs are stored in the ai_credentials table.
# This master key encrypts those database values and must remain outside the database.
AI_CREDENTIAL_ENCRYPTION_KEY="replace-with-at-least-32-random-characters"
AI_CREDENTIALS_ADMIN_TOKEN="replace-with-a-separate-admin-token"
ADMIN_ALLOWED_IPS=""
AI_PROVIDER_TIMEOUT_MS=55000
AI_PROVIDER_ALLOWED_HOSTS="api.openai.com,generativelanguage.googleapis.com"
AI_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
AI_CIRCUIT_BREAKER_COOLDOWN_MS=30000
